From 68bccf55fbeb4e7a7c8816177130b62e8a24a6e9 Mon Sep 17 00:00:00 2001
Date: Sat, 15 Feb 2025 16:03:16 -0600
Subject: [PATCH] Disable p212 bluetooth.

---
 arch/arm64/boot/dts/amlogic/meson-gxl-s905x-p212.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-gxl-s905x-p212.dtsi b/arch/arm64/boot/dts/amlogic/meson-gxl-s905x-p212.dtsi
index 7e7dc87ed..2380e7e0e 100644
--- a/arch/arm64/boot/dts/amlogic/meson-gxl-s905x-p212.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-gxl-s905x-p212.dtsi
@@ -186,6 +186,7 @@ &uart_A {
 	uart-has-rtscts;
 
 	bluetooth {
+		status = "disabled";
 		compatible = "brcm,bcm43438-bt";
 		shutdown-gpios = <&gpio GPIOX_17 GPIO_ACTIVE_HIGH>;
 		max-speed = <2000000>;
-- 
